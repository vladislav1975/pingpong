# Ignore Python cache and compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Ignore virtual environments
.venv/
venv/
ENV/
env/

# Ignore PyInstaller build folders
build/
dist/
*.spec

# Ignore system files
.DS_Store
Thumbs.db

# Ignore IDE/editor configs
.vscode/
.idea/
*.swp

# Ignore logs and temporary files
*.log
*.tmp

# Ignore screenshots or large media (optional)
screenshot.png
*.wav
*.jpg
*.png
